l/i/setup/images/prod/big/product-large,,2017/9/pr_2017_9_21_12_16_38_47_00.jpg","thumbnailUrl":"https://cdn.x-kom.pl/i/setup/images/prod/big/product-small,,2017/9/pr_2017_9_21_12_16_38_47_00.jpg","urlTemplate":"https://cdn.x-kom.pl/i/setup/images/prod/big/{SIZE},,2017/9/pr_2017_9_21_12_16_38_47_00.jpg"},{"url":"https://cdn.x-kom.pl/i/setup/images/prod/big/product-large,,pr_2015_8_24_13_6_14_885.jpg","thumbnailUrl":"https://cdn.x-kom.pl/i/setup/images/prod/big/product-small,,pr_2015_8_24_13_6_14_885.jpg","urlTemplate":"https://cdn.x-kom.pl/i/setup/images/prod/big/{SIZE},,pr_2015_8_24_13_6_14_885.jpg"},{"url":"https://cdn.x-kom.pl/i/setup/images/prod/big/product-large,,pr_2015_8_24_13_2_49_51.jpg","thumbnailUrl":"https://cdn.x-kom.pl/i/setup/images/prod/big/product-small,,pr_2015_8_24_13_2_49_51.jpg","urlTemplate":"https://cdn.x-kom.pl/i/setup/images/prod/big/{SIZE},,pr_2015_8_24_13_2_49_51.jpg"}],"comments":[{"productId":"59285","product":{"id":"59285","isUnavailable":false,"link":"/p/59285-karta-sieciowa-tp-link-tl-wn781nd--802.11b-g-n-150mb-s-.html","modifiers":[]},"id":"20669","authorName":"DonMiguel","isRegisteredAuthor":true,"isAdminAuthor":false,"createTime":"2016-01-24T12:58:30Z","isEditable":false,"isVoteAllowed":true,"title":null,"body":"Po czterech miesiącach codziennego chodzenia żeby zresetować router, ręcznego resetowania karty, wymianie anteny na bardziej czułą i masie innych cudów, podłączyłem 8-letnią kartę na usb w standardzie g. Dopiero wtedy problemy z brakiem stabilnego połączenia ustały. Innymi słowy - chłam jakich mało.","childComments":null,"votes":{"votesUp":12,"votesDown":7},"rating":2,"ratingFivePoints":2,"isRatingCalculatedFromSixPoints":true,"photos":null,"isConfirmedByPurchase":false},{"productId":"59285","product":{"id":"59285","isUnavailable":false,"link":"/p/59285-karta-sieciowa-tp-link-tl-wn781nd--802.11b-g-n-150mb-s-.html","modifiers":[]},"id":"72712","authorName":"Piotr","isRegisteredAuthor":true,"isAdminAuthor":false,"createTime":"2017-12-07T09:44:05Z","isEditable":false,"isVoteAllowed":true,"title":null,"body":"Z sterownikami pod Windows 10 nie ma problemu. Działają systemowe więc po podłączeniu karty nic nie trzeba dodatkowo instalować. Faktycznie z zasięgiem jest różnie. W niewielkim mieszkaniu gdzie sygnał przechodzi przez 2 ściany wskaźnik wacha się pomiędzy 2 a 4 kreski w skali na 5. Sporadycznie po restarcie zauważyłem, że karta długo się łączy ale to bardzo rzadko. Od strony codziennego użytkowania nic wielkiego nie doskwiera, karta działa i za tę cenę można raczej polecić.","childComments":null,"votes":{"votesUp":2,"votesDown":0},"rating":5,"ratingFivePoints":4,"isRatingCalculatedFromSixPoints":true,"photos":null,"isConfirmedByPurchase":true},{"productId":"59285","product":{"id":"59285","isUnavailable":false,"link":"/p/59285-karta-sieciowa-tp-link-tl-wn781nd--802.11b-g-n-150mb-s-.html","modifiers":[]},"id":"55025","authorName":"darek334","isRegisteredAuthor":true,"isAdminAuthor":false,"createTime":"2017-06-30T16:04:14Z","isEditable":false,"isVoteAllowed":true,"title":null,"body":"Niestety odradzam. Ogromny problem z Windows 10 i Ubuntu 16.04 na UEFI. Karta nie przyjmuje hasła, problem opisałem na forum Ubuntu, dziwna sytuacja. Tak jak poprzednicy opisują na poprzednim systemie słaby sygnał, ledwo, ledwo.","childComments":null,"votes":{"votesUp":3,"votesDown":0},"rating":1,"ratingFivePoints":1,"isRatingCalculatedFromSixPoints":true,"photos":null,"isConfirmedByPurchase":false},{"productId":"59285","product":{"id":"59285","isUnavailable":false,"link":"/p/59285-karta-sieciowa-tp-link-tl-wn781nd--802.11b-g-n-150mb-s-.html","modifiers":[]},"id":"225934","authorName":"Maciej","isRegisteredAuthor":true,"isAdminAuthor":false,"createTime":"2020-12-26T01:58:50Z","isEditable":false,"isVoteAllowed":true,"title":null,"body":"Tragiczna karta sieciowa. Nie wiem po co produkują taki szrot skoro swojego przeznaczenia w ogóle nie spełnia. Nie można się połączyć z żadną siecią, odrzuca hasła, zasięg 1/5 a w linii prostej 5m do routera... Tragedia. Sterowniki są ale po co skoro nie wnoszą niczego w porównaniu do tych od Microsoft? Nie spodziewałem się cudów po TP-Link ale takiego syfu na rynku bym się na ich miejscu wstydził. Nie polecam. Kupcie coś porządnego ludzie.","childComments":[{"productId":"59285","product":null,"id":"1000225934","authorName":"x-kom","isRegisteredAuthor":true,"isAdminAuthor":true,"createTime":"2020-12-28T16:47:29Z","isEditable":false,"isVoteAllowed":true,"title":null,"body":"Maciej, dziękujemy za opinię. Obecnie weryfikujemy Twoją sprawę. Karta ma 36 miesięcy gwarancji producenta — w razie występowania z nią jakiegokolwiek problemu skontaktuj się z naszym Serwisem pod numerem: 34 377 00 30 lub adresem: serwis@x-kom.pl. Postaramy się pomóc.","childComments":null,"votes":null,"rating":0,"ratingFivePoints":null,"isRatingCalculatedFromSixPoints":null,"photos":null,"isConfirmedByPurchase":true}],"votes":{"votesUp":1,"votesDown":0},"rating":1,"ratingFivePoints":1,"isRatingCalculatedFromSixPoints":true,"photos":null,"isConfirmedByPurchase":true},{"productId":"59285","product":{"id":"59285","isUnavailable":false,"link":"/p/59285-karta-sieciowa-tp-link-tl-wn781nd--802.11b-g-n-150mb-s-.html","modifiers":[]},"id":"350342","authorName":"Hubert","isRegisteredAuthor":true,"isAdminAuthor":false,"createTime":"2022-03-08T11:55:23Z","isEditable":false,"isVoteAllowed":true,"title":null,"body":"Działała przez kilka miesięcy tak jak w specyfikacji, następnie się posypało... Łączy ale jej prędkość spadła drastycznie.","childComments":[{"productId":"59285","product":null,"id":"1000350342","authorName":"x-kom","isRegisteredAuthor":true,"isAdminAuthor":true,"createTime":"2022-03-08T11:55:23Z","isEditable":false,"isVoteAllowed":true,"title":null,"body":"Hubercie, Twoja karta sieciowa powinna mieć trzyletnią gwarancję producenta. Nasz serwis próbował skontaktować się z Tobą mejlowo w tej sprawie. ","childComments":null,"votes":null,"rating":0,"ratingFivePoints":nul