024/9/pr_2024_9_9_23_26_21_103_00.jpg","thumbnailUrl":"https://cdn.x-kom.pl/i/setup/images/prod/big/product-small,,2024/9/pr_2024_9_9_23_26_21_103_00.jpg","urlTemplate":"https://cdn.x-kom.pl/i/setup/images/prod/big/{SIZE},,2024/9/pr_2024_9_9_23_26_21_103_00.jpg"},"grayedOutOption":false,"allProducts":["1278727"],"webUrls":[{"productId":"1278727","url":"https://www.x-kom.pl/p/1278727-sluchawki-bezprzewodowe-apple-airpods-max-p%C3%B3lnoc.html"}]},{"label":"Fioletowy","productId":"1278726","productPrice":{"grossValue":2215,"netValue":1800.81300813008,"taxValue":23},"priceInfo":{"price":2215,"oldPrice":null,"isPriceVisible":true,"minPrice":null},"photo":{"url":"https://cdn.x-kom.pl/i/setup/images/prod/big/product-large,,2024/9/pr_2024_9_9_23_27_41_776_00.jpg","thumbnailUrl":"https://cdn.x-kom.pl/i/setup/images/prod/big/product-small,,2024/9/pr_2024_9_9_23_27_41_776_00.jpg","urlTemplate":"https://cdn.x-kom.pl/i/setup/images/prod/big/{SIZE},,2024/9/pr_2024_9_9_23_27_41_776_00.jpg"},"grayedOutOption":false,"allProducts":["1278726"],"webUrls":[{"productId":"1278726","url":"https://www.x-kom.pl/p/1278726-sluchawki-bezprzewodowe-apple-airpods-max-fioletowy.html"}]},{"label":"Niebieski","productId":"1278723","productPrice":{"grossValue":2229,"netValue":1812.19512195122,"taxValue":23},"priceInfo":{"price":2229,"oldPrice":null,"isPriceVisible":true,"minPrice":null},"photo":{"url":"https://cdn.x-kom.pl/i/setup/images/prod/big/product-large,,2024/9/pr_2024_9_9_23_28_51_345_00.jpg","thumbnailUrl":"https://cdn.x-kom.pl/i/setup/images/prod/big/product-small,,2024/9/pr_2024_9_9_23_28_51_345_00.jpg","urlTemplate":"https://cdn.x-kom.pl/i/setup/images/prod/big/{SIZE},,2024/9/pr_2024_9_9_23_28_51_345_00.jpg"},"grayedOutOption":false,"allProducts":["1278723"],"webUrls":[{"productId":"1278723","url":"https://www.x-kom.pl/p/1278723-sluchawki-bezprzewodowe-apple-airpods-max-niebieski.html"}]},{"label":"Złoty","productId":"1278729","productPrice":{"grossValue":2219,"netValue":1804.06504065041,"taxValue":23},"priceInfo":{"price":2219,"oldPrice":null,"isPriceVisible":true,"minPrice":null},"photo":{"url":"https://cdn.x-kom.pl/i/setup/images/prod/big/product-large,,2024/9/pr_2024_9_9_23_24_56_298_00.jpg","thumbnailUrl":"https://cdn.x-kom.pl/i/setup/images/prod/big/product-small,,2024/9/pr_2024_9_9_23_24_56_298_00.jpg","urlTemplate":"https://cdn.x-kom.pl/i/setup/images/prod/big/{SIZE},,2024/9/pr_2024_9_9_23_24_56_298_00.jpg"},"grayedOutOption":false,"allProducts":["1278729"],"webUrls":[{"productId":"1278729","url":"https://www.x-kom.pl/p/1278729-sluchawki-bezprzewodowe-apple-airpods-max-ksiezycowa-poswiata.html"}]}],"showType":"Buttons"}],"isExtendedConfiguration":false,"isAvailableInDepartments":false,"leasingInfo":[{"name":"PKO","leasingCategoryId":12}],"productMarksExtended":[],"movies":[],"photos3D":[],"galleryItemsCount":11,"hasPromotionPrices":false,"buyBox":{"buyBoxItems":[{"type":"DeliveryDate_WithCutoff","props":{"mainText":"Najwcześniej u Ciebie: jutro","subtitle":"Zapłać w ciągu","cutoff":"2026-04-22T14:00:00Z"}},{"type":"DeliveryPrice_FreeDelivery","props":{"mainText":"Darmowa dostawa","subtitle":"Koszty dostawy"}},{"type":"DepartmentAvailability_DepartmentNotSelected","props":{"mainText":"Sprawdź dostępność w salonach","subtitle":"Kup i odbierz nawet jutro"}}]},"chargerInfo":{"min":null,"max":null,"included":false,"powerDelivery":false},"isSameDayDeliveryAvailable":false,"allowedCreditLines":[{"id":24,"paymentMethodId":"FreeInstallmentCreditAgricole","title":"Raty Credit Agricole 0% 3-20 rat","freeInstallment":true},{"id":16,"paymentMethodId":"FreeInstallmentSantander","title":"Raty Santander 0% 3-20 rat","freeInstallment":true},{"id":11,"paymentMethodId":"InstallmentSantander","title":"Raty Santander 0,65% 3-36 rat","freeInstallment":false},{"id":10,"paymentMethodId":"InstallmentAlior","title":"Raty Alior 0,65% (szybkie) 3-48 rat","freeInstallment":false},{"id":22,"paymentMethodId":"InstallmentCreditAgricole","title":"Raty Credit Agricole 3-50 rat","freeInstallment":false}],"featureSummary":["Łączność: Bezprzewodowe","Budowa słuchawek: Nauszne, Zamknięte","Mikrofon: Posiada, przy słuchawce","Redukcja hałasu: Aktywna - ANC","Złącze: USB typu-C  - 1 szt."],"featureSummaryStructured":[{"shortName":"Łączność","description":"Słuchawki przewodowe łączą się z drugim urządzeniem za pomocą kabla, natomiast bezprzewodowe używają do tego różnych standardów komunikacji bezprzewodowej, np. Bluetooth. Część słuchawek oferuje oba rodzaje łączności, łącząc ich zalety w postaci mobilności lub lepszej jakości dźwięku i mniejszych opóźnień. True Wireless jest zarezerwowane dla słuchawek dousznych i dokanałowych, które łączą się bezprzewodowo między sobą oraz ze źródłem dźwięku.","valueSeparator":", ","valueGroups":[{"shortName":"Bezprzewodowe","description":null}]},{"shortName":"Budowa słuchawek","description":"Słuchawki douszne i dokanałowe wkłada się do ucha. Pierwsze z nich opierają się na małżowinie usznej i są wygodne dla większości osób. Te dokanałowe wymagają lepszego dopasowania, ponieważ umieszcza się je trochę głębiej – w kanale słuchowym, zapewniając dobrą izolację i pewniejszy uchwyt.\r\n\u003cbr>\u003cbr>Konstrukcja słuchawek nausznych opiera się na całej głowie. Podział na słuchawki nauszne otwarte, półotwarte i zamknięte dotyczy wielkości i kształtu muszli. Te otwarte nie tłumią hałasów z zewnątrz, ale zapewniają lepszą wentylację, więc są dobrym wyborem do długotrwałego użytkowania lub joggingu po mieście. Słuchawki zamknięte szczelnie przylegają do ucha i odcinają od otoczenia, zapewniając lepsze odwzorowanie wysokich i niskich tonów. Słuchawki półotwarte łączą natomiast zalety obu konstrukcji.","valueSeparator":", ","valueGroups":[{"shortName":"Nauszne","description":null},{"shortName":"Zamknięte","description":null}]},{"shortName":"Mikrofon","description":null,"valueSeparator":", ","valueGroups":[{"shortName":"Posiada, przy słuchawce","description":null}]},{"shortName":"Redukcja hałasu","description":"Redukcja hałasu w słuchawkach przydaje się w zatłoczonych miejscach i może się odbywać pasywnie lub aktywnie (ANC). Redukcja pasywna polega na fizycznej blokadzie hałasów z zewnątrz, np. poprzez szczelne dopasowanie słuchawki dokanałowej do ucha, by niepożądane szumy nie przedostawały się przez tę barierę. Słuchawki wyposażone w ANC natomiast kontrolują poziom hałasu otoczenia za pomocą wbudowanych mikrofonów i generują dźwięk o częstotliwości, która niweluje niepożądane odgłosy.","valueSeparator":", ","valueGroups":[{"shortName":"Aktywna - ANC","description":"Redukcja szumów ANC (Active Noise Cancellation) to technologia stosowana w słuchawkach, która wykorzystuje mikrofony do wykrywania dźwięków otoczenia i generowania przeciwnie skierowanych fal dźwiękowych, neutralizujących hałasy. ANC działa w czasie rzeczywistym, redukując skutecznie dźwięki zewnętrzne i poprawiając doznania słuchowe podczas słuchania muzyki lub rozmów."}]},{"shortName":"Złącze","description":null,"valueSeparator":", ","valueGroups":[{"shortName":"USB typu-C  - 1 szt.","description":null}]}],"availabilityStatus":"Available","producerCode":"MWW53ZM/A","installmentMinimum":125.37,"freeInstallment":true,"alternativeGroupId":"11242","producer":{"id":"357","name":"Apple"},"secondaryCategory":[{"name":"Słuchawki bezprzewodowe","parentCategoryName":"Słuchawki","parentGroupName":"Laptopy i komputery"},{"name":"Słuchawki bezprzewodowe","parentCategoryName":"Słuchawki","parentGroupName":"TV i audio"},{"name":"Słuchawki bezprzewodowe","parentCategoryName":"Słuchawki","parentGroupName":"Akcesoria"}],"isEsd":false,"esdType":"NotDefined","isGiftCard":false,"isOnlyShippingFromDepartment":false,"productLink":"USE_SELECTOR_PLZ","photo":{"url":"https://cdn.x-kom.pl/i/setup/images/prod/big/product-large,,2024/9/pr_2024_9_9_23_24_56_298_00.jpg","thumbnailUrl":"https://cdn.x-kom.pl/i/setup/images/prod/big/product-small,,2024/9/pr_2024_9_9_23_24_56_298_00.jpg","urlTemplate":"https://cdn.x-kom.pl/i/setup/images/prod/big/{SIZE},,2024/9/pr_2024_9_9_23_24_56_298_00.jpg"},"rating":5.8,"ratingFivePoints":4.82,"ratingCount":168,"ratingStatistics":[{"rank":0,"rankFivePoints":1,"count":1,"totalCount":1},{"rank":0,"rankFivePoints":2,"count":1,"totalCount":1},{"rank":0,"rankFivePoints":3,"count":5,"totalCount":5},{"rank":0,"rankFivePoints":4,"count":13,"totalCount":13},{"rank":0,"rankFivePoints":5,"count":148,"totalCount":148}],"commentsCount":168,"commentStatistics":{"ratings":[{"rank":1,"rankFivePoints":0,"count":1,"totalCount":1},{"rank":2,"rankFivePoints":0,"count":1,"totalCount":1},{"rank":3,"rankFivePoints":0,"count":2,"totalCount":2},{"rank":4,"rankFivePoints":0,"count":3,"totalCount":3},{"rank":5,"rankFivePoints":0,"count":13,"totalCount":13},{"rank":6,"rankFivePoints":0,"count":148,"totalCount":148}],"ratingsFivePoints":[{"rank":0,"rankFivePoints":1,"count":1,"totalCount":1},{"rank":0,"rankFivePoints":2,"count":1,"totalCount":1},{"rank":0,"rankFivePoints":3,"count":5,"totalCount":5},{"rank":0,"rankFivePoints":4,"count":13,"totalCount":13},{"rank":0,"rankFivePoints":5,"count":148,"totalCount":148}],"totalConfirmedPurchase":163,"totalForThisVariant":14,"averageRating":5.8,"averageRatingFivePoints":4.82},"freeShipping":true,"features":[{"key":"Łączność","id":"019000000000","description":"Słuchawki przewodowe łączą się z drugim urządzeniem za pomocą kabla, natomiast bezprzewodowe używają do tego różnych standardów komunikacji bezprzewodowej, np. Bluetooth. Część słuchawek oferuje oba rodzaje łączności, łącząc ich zalety w postaci mobilności lub lepszej jakości dźwięku i mniejszych opóźnień. True Wireless jest zarezerwowane dla słuchawek dousznych i dokanałowych, które łączą się bezprzewodowo między sobą oraz ze źródłem dźwięku.","values":[{"name":"Bezprzewodowe","description":null}]},{"key":"Rodzaj łączności","id":"075770000000","description":"Większość słuchawek bezprzewodowych łączy się ze źródłem dźwięku za pomocą łączności Bluetooth dostępnej w wielu urządzeniach. Łączność radiowa jest natomiast bezkonkurencyjna, jeśli chodzi o zasięg i stabilność sygnału ze słuchawek. Łączność NFC ułatwia proces parowania słuchawek z drugim urządzeniem.","values":[{"name":"Bluetooth 5.0","description":null}]},{"key":"Budowa słuchawek","id":"018950000000","description":"Słuchawki douszne i dokanałowe wkłada się do ucha. Pierwsze z nich opierają się na małżowinie usznej i są wygodne dla większości osób. Te dokanałowe wymagają lepszego dopasowania, ponieważ umieszcza się je trochę głębiej – w kanale słuchowym, zapewniając dobrą izolację i pewniejszy uchwyt.\r\n\u003cbr>\u003cbr>Konstrukcja słuchawek nausznych opiera się na całej głowie. Podział na słuchawki nauszne otwarte, półotwarte i zamknięte dotyczy wielkości i kształtu muszli. Te otwarte nie tłumią hałasów z zewnątrz, ale zapewniają lepszą wentylację, więc są dobrym wyborem do długotrwałego użytkowania lub joggingu po mieście. Słuchawki zamknięte szczelnie przylegają do ucha i odcinają od otoczenia, zapewniając lepsze odwzorowanie wysokich i niskich tonów. Słuchawki półotwarte łączą natomiast zalety obu konstrukcji.","values":[{"name":"Nauszne","description":null},{"name":"Zamknięte","description":null}]},{"key":"Składana konstrukcja","id":"075780000000","description":"Przydaje się w przypadku słuchawek nausznych, których rozmiary są zdecydowanie większe od tych dousznych czy dokanałowych. Złożone słuchawki łatwiej i bezpieczniej przetransportować, a do tego zajmują mniej miejsca w plecaku czy torbie.","values":[{"name":"Tak","description":null}]},{"key":"System audio","id":"075790000000","description":"Słuchawki z systemem Stereo 2.0 najlepiej nadają się do słuchania muzyki. Ich dwa przetworniki pozwalają niezależnie wykorzystywać dwa kanały dźwięku w postaci prawej i lewej słuchawki. W efekcie wydobywający się z nich dźwięk jest zróżnicowany, a nie identyczny jak w przypadku systemu Mono. \r\n\u003cbr>\u003cbr>Słuchawki z prawdziwym systemem wielokanałowym 7.1 mogą mieć nawet 10 przetworników, które lepiej oddają przestrzeń w stosunku do systemu Stereo. Ten system przydaje się w grach, gdzie bardzo ważny jest kierunek i odległość, z jakiego dochodzi głos. Wirtualny system 7.1 to natomiast słuchawki z dwoma przetwornikami wzbogacone o specjalne oprogramowanie, które symuluje efekt dźwięku przestrzennego.","values":[{"name":"Stereo 2.0","description":null}]},{"key":"Redukcja hałasu","id":"075800000000","description":"Redukcja hałasu w słuchawkach przydaje się w zatłoczonych miejscach i może się odbywać pasywnie lub aktywnie (ANC). Redukcja pasywna polega na fizycznej blokadzie hałasów z zewnątrz, np. poprzez szczelne dopasowanie słuchawki dokanałowej do ucha, by niepożądane szumy nie przedostawały się przez tę barierę. Słuchawki wyposażone w ANC natomiast kontrolują poziom hałasu otoczenia za pomocą wbudowanych mikrofonów i generują dźwięk o częstotliwości, która niweluje niepożądane odgłosy.","values":[{"name":"Aktywna - ANC","description":"Redukcja szumów ANC (Active Noise Cancellation) to technologia stosowana w słuchawkach, która wykorzystuje mikrofony do wykrywania dźwięków otoczenia i generowania przeciwnie skierowanych fal dźwiękowych, neutralizujących hałasy. ANC działa w czasie rzeczywistym, redukując skutecznie dźwięki zewnętrzne i poprawiając doznania słuchowe podczas słuchania muzyki lub rozmów."}]},{"key":"Regulacja głośności","id":"075810000000","description":null,"values":[{"name":"Tak","description":null}]},{"key":"Wbudowany mikrofon","id":"019020000000","description":null,"values":[{"name":"Posiada, przy słuchawce","description":null}]},{"key":"Odłączany mikrofon","id":"075820000000","description":null,"values":[{"name":"Nie","description":null}]},{"key":"Złącze","id":"019010000000","description":null,"values":[{"name":"USB typu-C  - 1 szt.","description":null}]},{"key":"Odłączany kabel","id":"075850000000","description":null,"values":[{"name":"Tak","description":null}]},{"key":"Zasilanie","id":"072360000000","description":null,"values":[{"name":"Wbudowany akumulator","description":null}]},{"key":"Czas ładowania","id":"075860000000","description":null,"values":[{"name":"5 min ładowania = 1,5h pracy","description":null}]},{"key":"Maksymalny czas pracy","id":"074180000000","description":null,"values":[{"name":"do 20 h (przy włączonym ANC)","description":null}]},{"key":"Kompatybilność","id":"074170000000","description":null,"values":[{"name":"Mac OS","description":null},{"name":"iOS","description":null}]},{"key":"Materiał nauszników","id":"075880000000","description":null,"values":[{"name":"Pianka","description":null},{"name":"Tkanina","description":null}]},{"key":"Dodatkowe informacje","id":"019030000000","description":null,"values":[{"name":"Metalowa konstrukcja","description":null},{"name":"Regulowany pałąk","description":null},{"name":"Nauszniki składane na płasko","description":null},{"name":"Regulacja głośności","description":null},{"name":"Przetwornik dynamiczny","description":null},{"name":"Przycisk wielofunkcyjny","description":null},{"name":"Redukcja szumów otoczenia w mikrofonie","description":null},{"name":"Kończenie połączeń","description":null},{"name":"Sterowanie muzyką","description":null},{"name":"Automatyczne włączanie i parowanie","description":null},{"name":"Czujnik optyczny","description":null},{"name":"Czujnik żyroskopowy","description":null},{"name":"Dźwięk przestrzenny","description":null},{"name":"Akcelerometr","description":null}]},{"key":"Kolor","id":"057260000000","description":null,"values":[{"name":"Złoty","description":null}]},{"key":"Dołączone akcesoria","id":"019040000000","description":null,"values":[{"name":"Etui","description":null},{"name":"Kabel USB-C","description":null}]},{"key":"Waga","id":"019120000000","description":null,"values":[{"name":"386,2 g","description":null}]},{"key":"Gwarancja","id":"041790000000","description":null,"values":[{"name":"12 miesięcy (gwarancja producenta)","description":null}]}],"id":"1278729","name":"AirPods Max księżycowa poświata","price":2219